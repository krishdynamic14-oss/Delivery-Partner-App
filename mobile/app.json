{
  "expo": {
    "name": "Dynamic Bazar Delivery",
    "slug": "dynamic-bazar-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "online.dynamicbazar.delivery",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ff6b00"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dynamic Bazar needs your live location while the delivery app is open so admins can track field routes."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "00f0c33c-8253-4fdd-b037-79d308c03c1b"
      }
    }
  }
}
